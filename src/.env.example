# =============================================================================
# Threat Intelligence Correlation & Alert Prioritisation Assistant (.env)
# =============================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Backend Database Configuration (PostgreSQL / SQLite)
# PostgreSQL (Neon or local) Connection String
# Neon example: postgresql+psycopg2://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Local example: postgresql+psycopg2://postgres:password@localhost:5432/threat_intel
DATABASE_URL=postgresql+psycopg2://username:password@host:5432/database_name

# AI & LLM Inference Keys
# Groq Cloud API Key for Llama 3.3 70B (Recommendation Agent, BLUF Agent & Chat Analyst)
GROQ_API_KEY=gsk_your_groq_api_key_here

# IBM watsonx / IBM Cloud (if applicable)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# Qdrant Vector Database (Optional)
# If omitted or empty, Qdrant runs automatically in in-memory mode (:memory:).
# For Qdrant Cloud or Docker container:
# QDRANT_URL=https://xyz-example.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_URL=
QDRANT_API_KEY=

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Upstash Redis (Recommended for production caching — prevents repeated slow DB queries)
# Create a free database at https://console.upstash.com/ → Redis → Create Database → REST API
# Option A: Upstash REST SDK (recommended — serverless, no persistent socket needed)
# UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
#
# Option B: Standard Redis URL (works with Upstash rediss:// or any Redis instance)
# REDIS_URL=rediss://default:your_password@your-redis.upstash.io:6379
